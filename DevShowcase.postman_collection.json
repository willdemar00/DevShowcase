      "name": "3. Feedbacks e nota média",
      "item": [
        {
          "name": "21 - Feedback nota 5 no Mercadinho",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/projects/{{mercadinhoId}}/feedbacks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author_name\": \"Osanan José Leal\",\n  \"comment\": \"Achei os produtos rapidinho, muito prático.\",\n  \"rating\": 5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Feedback salvo com a média do projeto\", () => {",
                  "    pm.expect(r.rating).to.eql(5);",
                  "    pm.expect(r.project_avg_rating).to.be.within(1, 5);",
                  "    if (r.project_feedback_count === 1) pm.expect(r.project_avg_rating).to.eql(5);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "22 - Feedback nota 3 no Mercadinho (recalcula a média)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/projects/{{mercadinhoId}}/feedbacks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author_name\": \"Visitante\",\n  \"comment\": \"Faltou a opção de entrega em casa.\",\n  \"rating\": 3\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Média recalculada\", () => {",
                  "    pm.expect(r.project_avg_rating).to.be.within(1, 5);",
                  "    if (r.project_feedback_count === 2) pm.expect(r.project_avg_rating).to.eql(4);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "23 - Conferir curtidas e média na listagem",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/projects?technology=postgresql&page_size=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().results.find(x => x.id === Number(pm.collectionVariables.get(\"mercadinhoId\")));",
                  "pm.test(\"Mercadinho com curtidas e média\", () => {",
                  "    pm.expect(p.likes).to.eql(Number(pm.collectionVariables.get(\"mercadinhoLikes\")));",
                  "    pm.expect(p.avg_rating).to.not.eql(null);",
                  "    pm.expect(p.feedback_count).to.be.at.least(2);",
                  "});"
