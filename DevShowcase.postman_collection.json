              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const techs = pm.response.json();",
                  "[\"python\", \"fastapi\", \"postgresql\", \"react\"].forEach(nome => {",
                  "    const t = techs.find(x => x.name.toLowerCase() === nome);",
                  "    pm.test(`Tecnologia ${nome} cadastrada`, () => pm.expect(t).to.not.be.undefined);",
