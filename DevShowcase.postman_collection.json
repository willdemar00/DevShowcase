    {
      "name": "1. Listagem com filtro e paginação",
      "item": [
        {
          "name": "13 - Listar projetos (página 1, 10 por página)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/projects"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Tem paginação\", () => {",
                  "    pm.expect(r.page).to.eql(1);",
                  "    pm.expect(r.page_size).to.eql(10);",
                  "    pm.expect(r.total_items).to.be.at.least(3);",
                  "    pm.expect(r.total_pages).to.eql(Math.ceil(r.total_items / 10));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "14 - Filtrar por tecnologia (react)",
