# Copie este arquivo para .env (o .env não vai para o GitHub).
#
# Sem DATABASE_URL a API usa o SQLite local (devshowcase.db).
# Para usar um PostgreSQL, informe a URL de conexão:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/devshowcase
#
# No Render, DATABASE_URL é cadastrada no painel do Web Service
# com a Internal Database URL do banco.
DATABASE_URL=sqlite:///./devshowcase.db
